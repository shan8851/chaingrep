{
  "name": "chaingrep",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @chaingrep/api build",
    "build:web": "pnpm --filter @chaingrep/web build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "dev": "pnpm --parallel --filter @chaingrep/web --filter @chaingrep/api dev",
    "dev:api": "pnpm --filter @chaingrep/api dev",
    "dev:web": "pnpm --filter @chaingrep/web dev",
    "lint": "pnpm -r lint",
    "start:api": "pnpm --filter @chaingrep/api start",
    "start:web": "pnpm --filter @chaingrep/web start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.14",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.9",
    "wrangler": "^4.72.0"
  }
}
